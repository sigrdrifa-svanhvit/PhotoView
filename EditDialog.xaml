<Window x:Class="PhotoView.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画像の編集" Height="720" Width="1080"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="#FF111111" Foreground="White"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- プレビュー領域 -->
        <Grid Grid.Column="0" x:Name="Viewport" Background="#FF050505" ClipToBounds="True"
              SizeChanged="Viewport_SizeChanged"
              MouseLeftButtonDown="Preview_MouseLeftButtonDown"
              MouseMove="Preview_MouseMove"
              MouseLeftButtonUp="Preview_MouseLeftButtonUp"
              MouseDown="Preview_MouseDown"
              MouseUp="Preview_MouseUp"
              MouseWheel="Preview_MouseWheel">
            <Canvas x:Name="PreviewArea" HorizontalAlignment="Left" VerticalAlignment="Top"
                    ClipToBounds="False">
                <Image x:Name="PreviewImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Canvas.Left="0" Canvas.Top="0"/>
                <Rectangle x:Name="SelRect" Stroke="#FF37D3FF" StrokeThickness="1.5"
                           Fill="#3350A0C0" Visibility="Collapsed"
                           Canvas.Left="0" Canvas.Top="0"
                           StrokeDashArray="4 2"/>
                <Ellipse x:Name="RotateHandle" Width="13" Height="13" Fill="#FF4FC3F7"
                         Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False"
                         Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0"/>
                <Line x:Name="ImageRotateLine" Stroke="#FF4FC3F7" StrokeThickness="2"
                      Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0"/>
                <Ellipse x:Name="ImageRotateHandle" Width="15" Height="15" Fill="#FF4FC3F7"
                         Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False"
                         Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0"/>
                <Rectangle x:Name="ResizeFrame" Stroke="#FFFFB74D" StrokeThickness="2"
                           Fill="#22FFB74D" Visibility="Collapsed"
                           Canvas.Left="0" Canvas.Top="0" StrokeDashArray="6 3"/>
            </Canvas>

            <!-- ヒント（削除済み。画像上のクリックを妨げるため） -->

            <!-- 処理中 -->
            <Border x:Name="BusyOverlay" Background="#66000000"
                    Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="6" Padding="18,12">
                <TextBlock Text="処理中..." Foreground="White" FontSize="15" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- コントロールパネル -->
        <Border Grid.Column="1" BorderBrush="#FF2A2A2A" BorderThickness="1,0,0,0"
                Background="#FF161616">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14" Width="300">

                    <TextBlock Text="色調" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="明るさ" Width="60" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BrightnessLabel" DockPanel.Dock="Right" Width="34"
                                   Text="0" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="Brightness" Minimum="-100" Maximum="100" Value="0"
                                Margin="2,0,4,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="コントラスト" Width="60" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ContrastLabel" DockPanel.Dock="Right" Width="34"
                                   Text="0" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="Contrast" Minimum="-100" Maximum="100" Value="0"
                                Margin="2,0,4,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="彩度" Width="60" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SaturationLabel" DockPanel.Dock="Right" Width="34"
                                   Text="0" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="Saturation" Minimum="-100" Maximum="100" Value="0"
                                Margin="2,0,4,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="色相" Width="60" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HueLabel" DockPanel.Dock="Right" Width="34"
                                   Text="0" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="Hue" Minimum="-180" Maximum="180" Value="0"
                                Margin="2,0,4,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Button x:Name="ApplyColorBtn" Content="色調を適用" Margin="0,6,0,2"
                            Padding="0,6" Click="ApplyColor_Click"/>
                    <UniformGrid Columns="3" Margin="0,4">
                        <Button Content="グレースケール" Margin="2" Padding="0,6" Click="Grayscale_Click"/>
                        <Button Content="セピア" Margin="2" Padding="0,6" Click="Sepia_Click"/>
                        <Button Content="反転" Margin="2" Padding="0,6" Click="Invert_Click"/>
                    </UniformGrid>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="リサイズ" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <CheckBox x:Name="KeepRatio" Content="アスペクト比固定" IsChecked="True" Margin="0,2"/>
                    <ToggleButton x:Name="ResizeModeToggle" Content="任意リサイズ" Margin="0,4,0,0"
                                  Padding="0,6" Checked="ResizeMode_Changed" Unchecked="ResizeMode_Changed"/>
                    <Button x:Name="ResizeApplyBtn" Content="リサイズを適用" Margin="0,4,0,2"
                            Padding="0,6" Click="ResizeApply_Click" IsEnabled="False"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="回転 / 反転" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <UniformGrid Columns="2" Margin="0,2">
                        <Button Content="左に90°回転" Margin="2" Padding="0,6" Click="Rotate90Left_Click"/>
                        <Button Content="右に90°回転" Margin="2" Padding="0,6" Click="Rotate90Right_Click"/>
                        <Button Content="左右反転" Margin="2" Padding="0,6" Click="FlipH_Click"/>
                        <Button Content="上下反転" Margin="2" Padding="0,6" Click="FlipV_Click"/>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="角度" VerticalAlignment="Center" Width="34"/>
                        <TextBox x:Name="RotateAngle" Width="90" Height="24" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="回転を適用" Padding="10,0" Height="24" Click="RotateFree_Click"/>
                    </StackPanel>
                    <ToggleButton x:Name="ImageRotateToggle" Margin="0,6,0,0"
                                  Content="任意回転モード"
                                  Padding="0,6"
                                  Checked="ImageRotateToggle_Changed" Unchecked="ImageRotateToggle_Changed"/>
                    <Button x:Name="ApplyImgRotateBtn" Content="画像回転を適用" Margin="0,4,0,2"
                            Padding="0,6" Click="ApplyImgRotate_Click" IsEnabled="False"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="トリミング / モザイク" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <Button x:Name="CropBtn" Content="選択範囲でトリミング" Margin="0,0,0,4"
                            Padding="0,6" Click="Crop_Click"/>
                    <Button x:Name="CopyBtn" Content="選択範囲をコピー（クリップボード）" Margin="0,0,0,4"
                            Padding="0,6" Click="CopySelection_Click"/>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="モザイク強さ" Width="76" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MosaicLabel" DockPanel.Dock="Right" Width="30"
                                   Text="12" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="Mosaic" Minimum="2" Maximum="60" Value="12"
                                Margin="2,0,4,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Button x:Name="MosaicBtn" Content="選択範囲にモザイク" Margin="0,4,0,0"
                            Padding="0,6" Click="Mosaic_Click"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="ぼかし（ガウシアン）" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="強さ" Width="76" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BlurLabel" DockPanel.Dock="Right" Width="30"
                                   Text="10" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="Blur" Minimum="1" Maximum="50" Value="10"
                                Margin="2,0,4,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Button x:Name="BlurBtn" Content="ガウシアンブラー（選択 or 全体）" Margin="0,4,0,0"
                            Padding="0,6" Click="Blur_Click"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="超解像" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <Button x:Name="SuperResBtn" Content="超解像を適用（4倍・AI）" Padding="0,6"
                            Click="SuperRes_Click"/>
                    <Button x:Name="SuperResSameSizeBtn" Content="同サイズ超解像（画質向上・寸法不変）" Padding="0,6"
                            Margin="0,4,0,0" Click="SuperResSameSize_Click"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="保存" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="形式" VerticalAlignment="Center" Width="34"/>
                        <ComboBox x:Name="FormatCombo" Height="26" SelectedIndex="0">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPEG"/>
                            <ComboBoxItem Content="GIF"/>
                            <ComboBoxItem Content="BMP"/>
                            <ComboBoxItem Content="TIFF"/>
                            <ComboBoxItem Content="WebP"/>
                        </ComboBox>
                    </DockPanel>
                    <Button x:Name="SaveAsBtn" Content="名前を付けて保存..." Margin="0,4,0,2"
                            Padding="0,6" Click="SaveAs_Click"/>

                    <Separator Margin="0,12"/>

                    <Button Content="元に戻す（直近の操作を取り消す）" Padding="0,6" Margin="0,0,0,4"
                            Click="Undo_Click" x:Name="UndoBtn" IsEnabled="False"/>
                    <Button Content="すべての編集を破棄（元画像に戻す）" Padding="0,6" Margin="0,0,0,4"
                            Click="Reset_Click"/>
                    <Button Content="閉じる" Padding="0,6" Click="Close_Click"/>

                    <TextBlock x:Name="StatusText" Foreground="#8FC9FF" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
