<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>installer\app.ico</ApplicationIcon>
    <Version>1.8.0</Version>
    <Product>PhotoView</Product>
    <Description>画像・圧縮ファイル閲覧ビューア</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.39.0" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.116.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="RealESRGAN_x4plus_anime_4B32F.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PhotoView.Tests\**" />
    <EmbeddedResource Remove="PhotoView.Tests\**" />
    <None Remove="PhotoView.Tests\**" />
  </ItemGroup>

</Project>
